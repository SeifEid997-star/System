# =============================================================================
# Qlinic v2 - Environment Variables Configuration Template
# =============================================================================

# 1. Authentication & Security
# Generate a private random string of at least 32 characters (e.g. openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set to 'true' in Production/Vercel (HTTPS). Set to 'false' for local development on http://localhost
AUTH_COOKIE_SECURE=false

# 2. Supabase PostgreSQL Connection Strings
# Transaction Pooler (Port 6543) - Used by Next.js App Runtime on Vercel:
# Format: postgresql://postgres.[PROJECT_REF]:[ENCODED_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1

# Session Pooler (Port 5432) or Direct Connection - Used by Prisma CLI for migrations:
DIRECT_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres

# 3. One-Time Initial Owner Bootstrap (Empty Database Only)
# NOTE: INITIAL_OWNER_* is used strictly during initial setup (npm run db:seed:production).
# Never use demo passwords like Clinic@123 on production.
CLINIC_NAME="PetPals Veterinary Clinic"
CLINIC_SLUG="petpals"
CLINIC_EMAIL="info@petpals-vet.com"
CLINIC_PHONE="+20 100 123 4567"
CLINIC_ADDRESS="24 El-Tahrir St, Dokki, Giza, Egypt"
INITIAL_OWNER_NAME="Dr. Omar Khaled"
INITIAL_OWNER_EMAIL="owner@petpals-vet.com"
INITIAL_OWNER_PASSWORD="replace-with-a-unique-strong-production-password"
