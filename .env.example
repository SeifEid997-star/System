# Generate a private random value before production use (at least 32 characters).
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Set true only when serving over HTTPS. The default local/LAN launcher uses HTTP.
AUTH_COOKIE_SECURE=false

# Supabase PostgreSQL (Vercel runtime uses the transaction-pooler URL).
# Copy the exact connection strings from Supabase > Connect; do not commit real values.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Session-pooler or direct database connection used by Prisma CLI migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres

# One-time bootstrap inputs for `npm run db:seed:production` on an empty database.
# Do not leave INITIAL_OWNER_PASSWORD configured in Vercel after bootstrap.
CLINIC_NAME=PetPals Veterinary Clinic
CLINIC_SLUG=petpals
CLINIC_EMAIL=clinic@example.com
CLINIC_PHONE=+20 100 000 0000
CLINIC_ADDRESS=Clinic address
INITIAL_OWNER_NAME=Clinic Owner
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=replace-with-a-unique-strong-password
