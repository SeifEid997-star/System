{
  "name": "qlinic-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.prisma && next dev",
    "db:generate:local": "prisma generate --schema prisma/schema.prisma",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx tests/run-all-tests.ts",
    "db:push": "prisma db push",
    "db:generate:vercel": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:vercel": "node scripts/sync-postgres-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "db:migrate:deploy:vercel": "node scripts/sync-postgres-schema.mjs && prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:seed:production": "node scripts/sync-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma && tsx prisma/seed-production.ts",
    "db:setup:vercel": "npm run db:migrate:deploy:vercel && npm run db:seed:production",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean": "tsx scripts/clean-database.ts",
    "qa:scenarios": "tsx scripts/seed-qa-scenarios.ts",
    "qa:scenarios:clean": "tsx scripts/clean-qa-scenarios.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
